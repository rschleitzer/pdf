; Objects -- reading the objects of a PDF file as far as it takes to put its
; first page into another document as a form XObject: an image given as a
; PDF, as a word processor's check boxes and shapes come.
;
; What is read: the objects by their heads ("12 0 obj"), not by the
; cross-reference table, so a file whose objects lie in object streams is not
; read; the trailer's /Root, the page tree down to the first page, with what
; it inherits; its MediaBox; its content streams, without a filter or with
; FlateDecode; its resources, copied as direct objects with every reference
; followed. A resource that is a stream (a font, an image of the page) cannot
; be a direct object: such a page is refused rather than set without it.

use scaly.containers.Array
use pdf.Inflate.PdfInflate

define PdfObjects ()
{
    function is_space(c: u8) returns bool
        c = 0x20 or c = 0x0A or c = 0x0D or c = 0x09 or c = 0x0C or c = 0x00

    function is_delimiter(c: u8) returns bool
        c = 0x28 or c = 0x29 or c = 0x3C or c = 0x3E or c = 0x5B or c = 0x5D or c = 0x7B or c = 0x7D or c = 0x2F or c = 0x25

    ; Past white space and comments.
    function skip_space(data: Slice[u8], from: size_t) returns size_t
    {
        var at from
        while at < data.length
        {
            let c data[at]
            if PdfObjects.is_space(c)
                at := at + 1
            else if c = 0x25
            {
                while at < data.length and data[at] <> 0x0A and data[at] <> 0x0D
                    at := at + 1
            }
            else
                return at
        }
        at
    }

    ; The end of the token of regular characters at `at`.
    function token_end(data: Slice[u8], from: size_t) returns size_t
    {
        var at from
        while at < data.length and PdfObjects.is_space(data[at]) = false and PdfObjects.is_delimiter(data[at]) = false
            at := at + 1
        at
    }

    ; A whole number at `at`, where there is one, and where it ends.
    procedure integer(data: Slice[u8], from: size_t, mutable value: ref[int], mutable end: ref[size_t]) returns bool
    {
        var at from
        var n 0
        while at < data.length and data[at] >= 0x30 and data[at] <= 0x39
        {
            n := n * 10 + ((data[at] - 0x30) as int)
            at := at + 1
        }
        if at = from
            return false
        value := n
        end := at
        true
    }

    ; A number in thousandths: 13.8 is 13800.
    procedure number(data: Slice[u8], from: size_t, mutable milli: ref[int]) returns bool
    {
        var at PdfObjects.skip_space(data, from)
        var negative false
        if at < data.length and (data[at] = 0x2D or data[at] = 0x2B)
        {
            negative := data[at] = 0x2D
            at := at + 1
        }
        var whole 0
        var digits 0
        while at < data.length and data[at] >= 0x30 and data[at] <= 0x39
        {
            whole := whole * 10 + ((data[at] - 0x30) as int)
            digits := digits + 1
            at := at + 1
        }
        var n whole * 1000
        if at < data.length and data[at] = 0x2E
        {
            at := at + 1
            var unit 100
            while at < data.length and data[at] >= 0x30 and data[at] <= 0x39
            {
                n := n + ((data[at] - 0x30) as int) * unit
                unit := unit / 10
                digits := digits + 1
                at := at + 1
            }
        }
        if digits = 0
            return false
        if negative
            n := 0 - n
        milli := n
        true
    }

    ; The number of the object a reference at `at` names ("12 0 R").
    procedure reference(data: Slice[u8], from: size_t, mutable number: ref[int]) returns bool
    {
        let at PdfObjects.skip_space(data, from)
        var n 0
        var end: size_t 0
        if PdfObjects.integer(data, at, &n, &end) = false
            return false
        let g_at PdfObjects.skip_space(data, end)
        var g 0
        var g_end: size_t 0
        if PdfObjects.integer(data, g_at, &g, &g_end) = false
            return false
        let r_at PdfObjects.skip_space(data, g_end)
        if r_at >= data.length or data[r_at] <> 0x52 or PdfObjects.token_end(data, r_at) <> r_at + 1
            return false
        number := n
        true
    }

    ; Where the value of object `number` begins, 0 where there is none.
    procedure object_at(data: Slice[u8], number: int) returns size_t
    {
        var at: size_t 0
        while at < data.length
        {
            if (at = 0 or data[at - 1] = 0x0A or data[at - 1] = 0x0D) and data[at] >= 0x30 and data[at] <= 0x39
            {
                var n 0
                var end: size_t 0
                if PdfObjects.integer(data, at, &n, &end) and n = number
                {
                    let g_at PdfObjects.skip_space(data, end)
                    var g 0
                    var g_end: size_t 0
                    if PdfObjects.integer(data, g_at, &g, &g_end)
                    {
                        let k PdfObjects.skip_space(data, g_end)
                        if k + 3 <= data.length and data[k] = 0x6F and data[k + 1] = 0x62 and data[k + 2] = 0x6A
                            return k + 3
                    }
                }
            }
            at := at + 1
        }
        0
    }

    ; The value at `at`, a reference followed (once per level, at most 32).
    procedure resolve(data: Slice[u8], from: size_t) returns size_t
    {
        var at PdfObjects.skip_space(data, from)
        var hops 0
        var n 0
        while hops < 32 and PdfObjects.reference(data, at, &n)
        {
            let target PdfObjects.object_at(data, n)
            if target = 0
                return 0
            at := PdfObjects.skip_space(data, target)
            hops := hops + 1
        }
        at
    }

    ; Where the value at `at` ends.
    procedure skip_value(data: Slice[u8], from: size_t) returns size_t
    {
        var at PdfObjects.skip_space(data, from)
        if at >= data.length
            return at
        let c data[at]
        if c = 0x3C and at + 1 < data.length and data[at + 1] = 0x3C
        {
            at := at + 2
            repeat
            {
                at := PdfObjects.skip_space(data, at)
                if at + 1 >= data.length
                    return data.length
                if data[at] = 0x3E and data[at + 1] = 0x3E
                    return at + 2
                at := PdfObjects.skip_value(data, at)
                at := PdfObjects.skip_value(data, at)
            }
        }
        if c = 0x3C
        {
            while at < data.length and data[at] <> 0x3E
                at := at + 1
            return at + 1
        }
        if c = 0x5B
        {
            at := at + 1
            repeat
            {
                at := PdfObjects.skip_space(data, at)
                if at >= data.length
                    return at
                if data[at] = 0x5D
                    return at + 1
                at := PdfObjects.skip_value(data, at)
            }
        }
        if c = 0x28
        {
            var depth 0
            while at < data.length
            {
                let d data[at]
                if d = 0x5C
                    at := at + 1
                else if d = 0x28
                    depth := depth + 1
                else if d = 0x29
                {
                    depth := depth - 1
                    if depth = 0
                        return at + 1
                }
                at := at + 1
            }
            return at
        }
        if c = 0x2F
            return PdfObjects.token_end(data, at + 1)
        var n 0
        if PdfObjects.reference(data, at, &n)
        {
            ; past the R
            var end: size_t 0
            PdfObjects.integer(data, at, &n, &end)
            var g 0
            PdfObjects.integer(data, PdfObjects.skip_space(data, end), &g, &end)
            return PdfObjects.skip_space(data, end) + 1
        }
        let end PdfObjects.token_end(data, at)
        if end = at
            return at + 1
        end
    }

    ; In the dictionary at `at`, where the value of `key` begins; 0 where
    ; the dictionary has none.
    procedure lookup(data: Slice[u8], dict: size_t, key: Slice[u8]) returns size_t
    {
        var at PdfObjects.skip_space(data, dict)
        if at + 1 >= data.length or data[at] <> 0x3C or data[at + 1] <> 0x3C
            return 0
        at := at + 2
        repeat
        {
            at := PdfObjects.skip_space(data, at)
            if at + 1 >= data.length
                return 0
            if data[at] = 0x3E and data[at + 1] = 0x3E
                return 0
            if data[at] <> 0x2F
                return 0
            let name_end PdfObjects.token_end(data, at + 1)
            let value_at name_end
            if name_end - (at + 1) = key.length
            {
                var same true
                var i: size_t 0
                while i < key.length and same
                {
                    if data[at + 1 + i] <> key[i]
                        same := false
                    i := i + 1
                }
                if same
                    return value_at
            }
            at := PdfObjects.skip_value(data, value_at)
        }
        0
    }

    ; Is the name at `at` (references followed) this one?
    procedure is_name(data: Slice[u8], from: size_t, name: Slice[u8]) returns bool
    {
        let at PdfObjects.resolve(data, from)
        if at = 0 or at >= data.length or data[at] <> 0x2F
            return false
        let end PdfObjects.token_end(data, at + 1)
        if end - (at + 1) <> name.length
            return false
        var i: size_t 0
        while i < name.length
        {
            if data[at + 1 + i] <> name[i]
                return false
            i := i + 1
        }
        true
    }

    ; The value at `at` as a direct object into `out`: every reference
    ; followed. False where one leads to a stream, or the nesting goes deeper
    ; than 32.
    procedure copy_direct(data: Slice[u8], from: size_t, mutable out: ref[Array[u8]], depth: int) returns bool
    {
        if depth > 32
            return false
        var at PdfObjects.skip_space(data, from)
        var n 0
        if PdfObjects.reference(data, at, &n)
        {
            let target PdfObjects.object_at(data, n)
            if target = 0
            {
                out.add("null")
                return true
            }
            ; a stream object cannot be copied as a direct one
            let end PdfObjects.skip_value(data, target)
            let k PdfObjects.skip_space(data, end)
            if k + 6 <= data.length and data[k] = 0x73 and data[k + 1] = 0x74 and data[k + 2] = 0x72 and data[k + 3] = 0x65 and data[k + 4] = 0x61 and data[k + 5] = 0x6D
                return false
            return PdfObjects.copy_direct(data, target, out, depth + 1)
        }
        if at >= data.length
            return false
        let c data[at]
        if c = 0x3C and at + 1 < data.length and data[at + 1] = 0x3C
        {
            out.add("<<")
            at := at + 2
            repeat
            {
                at := PdfObjects.skip_space(data, at)
                if at + 1 >= data.length
                    return false
                if data[at] = 0x3E and data[at + 1] = 0x3E
                    break
                let key_end PdfObjects.skip_value(data, at)
                out.add(data.subslice(at, key_end))
                out.add(0x20)
                if PdfObjects.copy_direct(data, key_end, out, depth + 1) = false
                    return false
                out.add(0x20)
                at := PdfObjects.skip_value(data, key_end)
            }
            out.add(">>")
            return true
        }
        if c = 0x5B
        {
            out.add(0x5B)
            at := at + 1
            repeat
            {
                at := PdfObjects.skip_space(data, at)
                if at >= data.length
                    return false
                if data[at] = 0x5D
                    break
                if PdfObjects.copy_direct(data, at, out, depth + 1) = false
                    return false
                out.add(0x20)
                at := PdfObjects.skip_value(data, at)
            }
            out.add(0x5D)
            return true
        }
        let end PdfObjects.skip_value(data, at)
        out.add(data.subslice(at, end))
        true
    }

    ; The data of the stream whose dictionary begins at `at`, decoded, onto
    ; `out`: without a filter or with FlateDecode only.
    procedure stream_data(data: Slice[u8], dict: size_t, mutable out: ref[Array[u8]]) returns bool
    {
        let end PdfObjects.skip_value(data, dict)
        var at PdfObjects.skip_space(data, end)
        if at + 6 > data.length or data[at] <> 0x73 or data[at + 1] <> 0x74 or data[at + 2] <> 0x72
            return false
        at := at + 6
        ; the end of the line after the keyword
        if at < data.length and data[at] = 0x0D
            at := at + 1
        if at < data.length and data[at] = 0x0A
            at := at + 1
        let length_at PdfObjects.lookup(data, dict, "Length")
        if length_at = 0
            return false
        var length 0
        if PdfObjects.number(data, PdfObjects.resolve(data, length_at), &length) = false
            return false
        length := length / 1000
        if length < 0 or at + (length as size_t) > data.length
            return false
        let bytes data.subslice(at, at + (length as size_t))
        let filter PdfObjects.lookup(data, dict, "Filter")
        if filter = 0
        {
            out.add(bytes)
            return true
        }
        if PdfObjects.is_name(data, filter, "FlateDecode") = false or bytes.length < 2
            return false
        ; past the two bytes of the zlib header
        var inflate PdfInflate()
        inflate.run(bytes.slice_from(2), out)
    }

    ; Where the dictionary of the first page begins, 0 where it is not found:
    ; from the trailer's /Root through /Pages and the first of the /Kids.
    procedure first_page(data: Slice[u8]) returns size_t
    {
        ; the last trailer of the file
        var trailer: size_t 0
        var at: size_t 0
        while at + 7 <= data.length
        {
            if data[at] = 0x74 and data[at + 1] = 0x72 and data[at + 2] = 0x61 and data[at + 3] = 0x69 and data[at + 4] = 0x6C and data[at + 5] = 0x65 and data[at + 6] = 0x72
                trailer := at + 7
            at := at + 1
        }
        if trailer = 0
            return 0
        let root_at PdfObjects.lookup(data, trailer, "Root")
        if root_at = 0
            return 0
        let root PdfObjects.resolve(data, root_at)
        if root = 0
            return 0
        let pages_at PdfObjects.lookup(data, root, "Pages")
        if pages_at = 0
            return 0
        var node PdfObjects.resolve(data, pages_at)
        var depth 0
        while node <> 0 and depth < 32
        {
            if PdfObjects.is_name(data, PdfObjects.lookup(data, node, "Type"), "Page")
                return node
            let kids_at PdfObjects.lookup(data, node, "Kids")
            if kids_at = 0
                return 0
            let kids PdfObjects.resolve(data, kids_at)
            if kids = 0 or kids >= data.length or data[kids] <> 0x5B
                return 0
            node := PdfObjects.resolve(data, kids + 1)
            depth := depth + 1
        }
        0
    }

    ; The value of `key` in the page or, inherited, in the nodes above it.
    procedure inherited(data: Slice[u8], page: size_t, key: Slice[u8]) returns size_t
    {
        var node page
        var depth 0
        while node <> 0 and depth < 32
        {
            let at PdfObjects.lookup(data, node, key)
            if at <> 0
                return at
            let parent PdfObjects.lookup(data, node, "Parent")
            if parent = 0
                return 0
            node := PdfObjects.resolve(data, parent)
            depth := depth + 1
        }
        0
    }

    ; The MediaBox of the first page in thousandths of a point: its lower
    ; left corner and its size.
    procedure media_box(data: Slice[u8], mutable x: ref[int], mutable y: ref[int], mutable width: ref[int], mutable height: ref[int]) returns bool
    {
        let page PdfObjects.first_page(data)
        if page = 0
            return false
        let box_at PdfObjects.inherited(data, page, "MediaBox")
        if box_at = 0
            return false
        var at PdfObjects.resolve(data, box_at)
        if at = 0 or data[at] <> 0x5B
            return false
        at := at + 1
        var v Array[int]()
        var k 0
        while k < 4
        {
            at := PdfObjects.skip_space(data, at)
            var n 0
            if PdfObjects.number(data, PdfObjects.resolve(data, at), &n) = false
                return false
            v.add(n)
            at := PdfObjects.skip_value(data, at)
            k := k + 1
        }
        x := v[0]
        y := v[1]
        width := v[2] - v[0]
        height := v[3] - v[1]
        width > 0 and height > 0
    }
}
