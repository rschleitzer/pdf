; TrueType -- reading a TrueType font file: which glyph a character has, how
; wide a glyph is, and the font again with only the glyphs a document uses.
;
; Nothing is built up from a font: its file lies in a buffer of the caller,
; and a font is a RECORD of numbers -- where its tables are in that buffer
; and the few values a PDF asks for -- appended to a list of the caller.
; Every question is answered from the tables as they stand.
;
; The outlines must be TrueType's (a `glyf` table); a font with PostScript
; outlines (`OTTO`) is refused. Of a collection (`ttcf`) the first font is
; taken.
;
; The subset keeps every glyph's NUMBER, so a text written with the font's
; glyph numbers needs no translation: the glyphs not used are simply empty.
; It holds the tables a PDF reader needs of an embedded font and no others.

; the record of a font: the offsets are into the caller's buffer
define PTT_SIZE: size_t 34
define PTT_UNITS: size_t 0
define PTT_GLYPHS: size_t 1
define PTT_METRICS: size_t 2
define PTT_ASCENDER: size_t 3
define PTT_DESCENDER: size_t 4
; x min, y min, x max, y max
define PTT_BOX: size_t 5
; in whole degrees
define PTT_ITALIC: size_t 9
; the character map taken, and its format (4 or 12)
define PTT_MAP: size_t 10
define PTT_MAP_FORMAT: size_t 11
; 1: the glyph locations are four bytes each, 0: two, counting words
define PTT_LONG: size_t 12
; table by table its offset and its length
define PTT_HEAD: size_t 13
define PTT_HHEA: size_t 15
define PTT_HMTX: size_t 17
define PTT_MAXP: size_t 19
define PTT_LOCA: size_t 21
define PTT_GLYF: size_t 23
define PTT_CVT: size_t 25
define PTT_FPGM: size_t 27
define PTT_PREP: size_t 29
; its PostScript name in the caller's names
define PTT_NAME: size_t 31
; head.macStyle: bit 0 bold, bit 1 italic
define PTT_STYLE: size_t 33

define PdfTrueType (unused: int)
{
    function u16(data: Slice[u8], at: size_t) returns int
    {
        if at + 2 > data.length
            return 0
        ((data[at] as int) << 8) | (data[at + 1] as int)
    }

    function i16(data: Slice[u8], at: size_t) returns int
    {
        let v PdfTrueType.u16(data, at)
        if v >= 32768
            return v - 65536
        v
    }

    function u32(data: Slice[u8], at: size_t) returns int
    {
        if at + 4 > data.length
            return 0
        ((data[at] as int) << 24) | ((data[at + 1] as int) << 16) | ((data[at + 2] as int) << 8) | (data[at + 3] as int)
    }

    ; Where the entry of a table is in the directory of the font at `font`,
    ; 0 when the font has no such table.
    function entry(data: Slice[u8], font: size_t, tag: Slice[u8]) returns size_t
    {
        let count PdfTrueType.u16(data, font + 4) as size_t
        var i: size_t 0
        while i < count
        {
            let at font + 12 + i * 16
            if at + 16 > data.length
                return 0
            if data[at] = tag[0] and data[at + 1] = tag[1] and data[at + 2] = tag[2] and data[at + 3] = tag[3]
                return at
            i := i + 1
        }
        0
    }

    ; Read the font file that lies at `file` in `data` and append its record
    ; to `records`, its PostScript name to `names`. False when it is no
    ; TrueType font this package can use.
    procedure parse(data: Slice[u8], file: size_t, mutable records: ref[Array[int]], mutable names: ref[Array[u8]]) returns bool
    {
        if file + 12 > data.length
            return false
        var font file
        ; a collection: its first font
        if data[file] = 0x74 and data[file + 1] = 0x74 and data[file + 2] = 0x63 and data[file + 3] = 0x66
            font := file + (PdfTrueType.u32(data, file + 12) as size_t)
        let version PdfTrueType.u32(data, font)
        ; 1.0, or `true`
        if version <> 65536 and version <> 1953658213
            return false
        let head PdfTrueType.entry(data, font, "head")
        let hhea PdfTrueType.entry(data, font, "hhea")
        let hmtx PdfTrueType.entry(data, font, "hmtx")
        let maxp PdfTrueType.entry(data, font, "maxp")
        let loca PdfTrueType.entry(data, font, "loca")
        let glyf PdfTrueType.entry(data, font, "glyf")
        let cmap PdfTrueType.entry(data, font, "cmap")
        if head = 0 or hhea = 0 or hmtx = 0 or maxp = 0 or loca = 0 or glyf = 0 or cmap = 0
            return false
        let head_at file + (PdfTrueType.u32(data, head + 8) as size_t)
        let hhea_at file + (PdfTrueType.u32(data, hhea + 8) as size_t)
        let maxp_at file + (PdfTrueType.u32(data, maxp + 8) as size_t)
        let cmap_at file + (PdfTrueType.u32(data, cmap + 8) as size_t)
        if head_at + 54 > data.length or hhea_at + 36 > data.length or maxp_at + 6 > data.length
            return false
        ; the character map: Unicode in full if the font has it, else the
        ; basic plane; a Windows table before one without a platform
        var map: size_t 0
        var format 0
        var rank 0
        let tables PdfTrueType.u16(data, cmap_at + 2) as size_t
        var i: size_t 0
        while i < tables
        {
            let rec cmap_at + 4 + i * 8
            let platform PdfTrueType.u16(data, rec)
            let encoding PdfTrueType.u16(data, rec + 2)
            let at cmap_at + (PdfTrueType.u32(data, rec + 4) as size_t)
            let f PdfTrueType.u16(data, at)
            var r 0
            if f = 12 and platform = 3 and encoding = 10
                r := 4
            else if f = 12 and platform = 0
                r := 3
            else if f = 4 and platform = 3 and encoding = 1
                r := 2
            else if f = 4 and platform = 0
                r := 1
            if r > rank
            {
                rank := r
                map := at
                format := f
            }
            i := i + 1
        }
        if rank = 0
            return false
        let units PdfTrueType.u16(data, head_at + 18)
        if units = 0
            return false
        records.add(units)
        records.add(PdfTrueType.u16(data, maxp_at + 4))
        records.add(PdfTrueType.u16(data, hhea_at + 34))
        records.add(PdfTrueType.i16(data, hhea_at + 4))
        records.add(PdfTrueType.i16(data, hhea_at + 6))
        records.add(PdfTrueType.i16(data, head_at + 36))
        records.add(PdfTrueType.i16(data, head_at + 38))
        records.add(PdfTrueType.i16(data, head_at + 40))
        records.add(PdfTrueType.i16(data, head_at + 42))
        ; the italic angle, a 16.16 number in `post`
        var italic 0
        let post PdfTrueType.entry(data, font, "post")
        if post <> 0
            italic := PdfTrueType.i16(data, file + (PdfTrueType.u32(data, post + 8) as size_t) + 4)
        records.add(italic)
        records.add(map as int)
        records.add(format)
        records.add(PdfTrueType.u16(data, head_at + 50))
        PdfTrueType.add_table(data, file, head, records)
        PdfTrueType.add_table(data, file, hhea, records)
        PdfTrueType.add_table(data, file, hmtx, records)
        PdfTrueType.add_table(data, file, maxp, records)
        PdfTrueType.add_table(data, file, loca, records)
        PdfTrueType.add_table(data, file, glyf, records)
        PdfTrueType.add_table(data, file, PdfTrueType.entry(data, font, "cvt "), records)
        PdfTrueType.add_table(data, file, PdfTrueType.entry(data, font, "fpgm"), records)
        PdfTrueType.add_table(data, file, PdfTrueType.entry(data, font, "prep"), records)
        records.add(names.get_length() as int)
        let name PdfTrueType.entry(data, font, "name")
        if name <> 0
            PdfTrueType.name(data, file + (PdfTrueType.u32(data, name + 8) as size_t), 6, names)
        records.add((names.get_length() as int) - records[records.get_length() - 1])
        records.add(PdfTrueType.u16(data, head_at + 44))
        true
    }

    ; The offset and the length of the table a directory entry names; two
    ; zeros for no entry.
    procedure add_table(data: Slice[u8], file: size_t, entry: size_t, mutable records: ref[Array[int]])
    {
        if entry = 0
        {
            records.add(0)
            records.add(0)
            return
        }
        let at file + (PdfTrueType.u32(data, entry + 8) as size_t)
        let length PdfTrueType.u32(data, entry + 12) as size_t
        if at + length > data.length
        {
            records.add(0)
            records.add(0)
            return
        }
        records.add(at as int)
        records.add(length as int)
    }

    ; Append one of a font's names (1 the family, 6 the PostScript name) from
    ; the name table at `table`, as plain characters: a Windows name in
    ; English before any other. What is no ASCII character becomes `?`.
    procedure name(data: Slice[u8], table: size_t, which: int, mutable to: ref[Array[u8]])
    {
        let count PdfTrueType.u16(data, table + 2) as size_t
        let strings table + (PdfTrueType.u16(data, table + 4) as size_t)
        var best: size_t 0
        var rank 0
        var i: size_t 0
        while i < count
        {
            let rec table + 6 + i * 12
            if PdfTrueType.u16(data, rec + 6) = which
            {
                let platform PdfTrueType.u16(data, rec)
                var r 1
                if platform = 3 and PdfTrueType.u16(data, rec + 4) = 1033
                    r := 4
                else if platform = 3
                    r := 3
                else if platform = 1
                    r := 2
                if r > rank
                {
                    rank := r
                    best := rec
                }
            }
            i := i + 1
        }
        if rank = 0
            return
        let wide PdfTrueType.u16(data, best) <> 1
        let length PdfTrueType.u16(data, best + 8) as size_t
        let at strings + (PdfTrueType.u16(data, best + 10) as size_t)
        if at + length > data.length
            return
        var k: size_t 0
        while k < length
        {
            var c data[at + k]
            if wide
            {
                ; two bytes a character, the higher first
                if k + 1 >= length
                    break
                c := data[at + k + 1]
                if data[at + k] <> 0
                    c := 0x3F
                k := k + 1
            }
            if c < 0x20 or c > 0x7E
                c := 0x3F
            to.add(c)
            k := k + 1
        }
    }

    ; The glyph of a character in the font whose record begins at `r`; 0,
    ; the glyph for what a font does not have, when it has none.
    function glyph(data: Slice[u8], records: ref[Array[int]], r: size_t, ch: u32) returns int
    {
        let map records[r + PTT_MAP] as size_t
        let c ch as int
        if records[r + PTT_MAP_FORMAT] = 12
        {
            ; groups of first character, last character, first glyph
            var low: size_t 0
            var high PdfTrueType.u32(data, map + 12) as size_t
            while low < high
            {
                let middle (low + high) / 2
                let group map + 16 + middle * 12
                if c > PdfTrueType.u32(data, group + 4)
                    low := middle + 1
                else if c < PdfTrueType.u32(data, group)
                    high := middle
                else
                    return PdfTrueType.u32(data, group + 8) + c - PdfTrueType.u32(data, group)
            }
            return 0
        }
        if c > 65535
            return 0
        ; segments: four arrays of their last characters, first characters,
        ; deltas and range offsets, one behind the other
        let width PdfTrueType.u16(data, map + 6) as size_t
        let ends map + 14
        var low: size_t 0
        var high width / 2
        while low < high
        {
            let middle (low + high) / 2
            if PdfTrueType.u16(data, ends + middle * 2) < c
                low := middle + 1
            else
                high := middle
        }
        if low >= width / 2
            return 0
        let first PdfTrueType.u16(data, ends + 2 + width + low * 2)
        if c < first
            return 0
        let delta PdfTrueType.u16(data, ends + 2 + width * 2 + low * 2)
        let range_at ends + 2 + width * 3 + low * 2
        let range PdfTrueType.u16(data, range_at) as size_t
        if range = 0
            return (c + delta) & 65535
        let g PdfTrueType.u16(data, range_at + range + ((c - first) as size_t) * 2)
        if g = 0
            return 0
        (g + delta) & 65535
    }

    ; The advance of a glyph in the font's units.
    function advance(data: Slice[u8], records: ref[Array[int]], r: size_t, glyph: int) returns int
    {
        let metrics records[r + PTT_METRICS]
        if metrics = 0
            return 0
        var g glyph
        if g >= metrics
            g := metrics - 1
        PdfTrueType.u16(data, (records[r + PTT_HMTX] as size_t) + (g as size_t) * 4)
    }

    ; Where glyph g begins in the glyph table (g may be the number of
    ; glyphs: then where the last one ends).
    function location(data: Slice[u8], records: ref[Array[int]], r: size_t, g: int) returns size_t
    {
        let loca records[r + PTT_LOCA] as size_t
        if records[r + PTT_LONG] <> 0
            return PdfTrueType.u32(data, loca + (g as size_t) * 4) as size_t
        (PdfTrueType.u16(data, loca + (g as size_t) * 2) as size_t) * 2
    }

    function is_used(used: ref[Array[u8]], used_at: size_t, g: int) returns bool
        ((used[used_at + ((g / 8) as size_t)] as int) & (1 << (g % 8))) <> 0

    ; Write the font again into `out` (which is emptied first), with the
    ; outlines of only the glyphs whose bit is set in `used` from `used_at`
    ; on -- and of the glyphs those are composed of, whose bits are set here.
    procedure subset(data: Slice[u8], records: ref[Array[int]], r: size_t, mutable used: ref[Array[u8]], used_at: size_t, mutable out: ref[Array[u8]])
    {
        out.clear()
        let glyphs records[r + PTT_GLYPHS]
        let glyf records[r + PTT_GLYF] as size_t
        let glyf_length records[r + PTT_GLYF + 1] as size_t
        ; the glyph for what the font does not have is always there
        used.put(used_at, used[used_at] | 1)
        ; a composed glyph names its parts: take them along, and theirs
        var again true
        while again
        {
            again := false
            var g 0
            while g < glyphs
            {
                if PdfTrueType.is_used(used, used_at, g)
                {
                    let from PdfTrueType.location(data, records, r, g)
                    let to PdfTrueType.location(data, records, r, g + 1)
                    if to > from + 10 and to <= glyf_length and PdfTrueType.i16(data, glyf + from) < 0
                    {
                        var at glyf + from + 10
                        repeat
                        {
                            if at + 4 > glyf + to
                                break
                            let flags PdfTrueType.u16(data, at)
                            let part PdfTrueType.u16(data, at + 2)
                            if part < glyphs and PdfTrueType.is_used(used, used_at, part) = false
                            {
                                let cell used_at + ((part / 8) as size_t)
                                used.put(cell, used[cell] | ((1 << (part % 8)) as u8))
                                again := true
                            }
                            ; its arguments, bytes or words, and its scale
                            at := at + 6
                            if (flags & 1) <> 0
                                at := at + 2
                            if (flags & 8) <> 0
                                at := at + 2
                            else if (flags & 64) <> 0
                                at := at + 4
                            else if (flags & 128) <> 0
                                at := at + 8
                            if (flags & 32) = 0
                                break
                        }
                    }
                }
                g := g + 1
            }
        }
        ; the tables, in the order of their names
        var tables 6
        if records[r + PTT_CVT + 1] > 0
            tables := tables + 1
        if records[r + PTT_FPGM + 1] > 0
            tables := tables + 1
        if records[r + PTT_PREP + 1] > 0
            tables := tables + 1
        PdfTrueType.put32(out, 65536)
        PdfTrueType.put16(out, tables)
        ; the three numbers a binary search of the directory wants
        var power 1
        var log 0
        while power * 2 <= tables
        {
            power := power * 2
            log := log + 1
        }
        PdfTrueType.put16(out, power * 16)
        PdfTrueType.put16(out, log)
        PdfTrueType.put16(out, tables * 16 - power * 16)
        ; the directory is filled in as the tables are written
        let directory out.get_length()
        var i 0
        while i < tables * 16
        {
            out.add(0)
            i := i + 1
        }
        var slot directory
        var head_at: size_t 0
        if records[r + PTT_CVT + 1] > 0
        {
            PdfTrueType.begin_table(out, slot, "cvt ")
            PdfTrueType.copy_table(data, records, r + PTT_CVT, out)
            PdfTrueType.end_table(out, slot)
            slot := slot + 16
        }
        if records[r + PTT_FPGM + 1] > 0
        {
            PdfTrueType.begin_table(out, slot, "fpgm")
            PdfTrueType.copy_table(data, records, r + PTT_FPGM, out)
            PdfTrueType.end_table(out, slot)
            slot := slot + 16
        }
        ; glyf: the outlines used, each at a multiple of four
        PdfTrueType.begin_table(out, slot, "glyf")
        let new_glyf out.get_length()
        var g 0
        while g < glyphs
        {
            if PdfTrueType.is_used(used, used_at, g)
            {
                let from PdfTrueType.location(data, records, r, g)
                let to PdfTrueType.location(data, records, r, g + 1)
                if to > from and to <= glyf_length
                {
                    out.add(data.subslice(glyf + from, glyf + to))
                    while ((out.get_length() - new_glyf) & 3) <> 0
                        out.add(0)
                }
            }
            g := g + 1
        }
        PdfTrueType.end_table(out, slot)
        slot := slot + 16
        ; head: its checksum adjustment empty for now, its locations long
        PdfTrueType.begin_table(out, slot, "head")
        head_at := out.get_length()
        PdfTrueType.copy_table(data, records, r + PTT_HEAD, out)
        PdfTrueType.patch32(out, head_at + 8, 0)
        out.put(head_at + 50, 0)
        out.put(head_at + 51, 1)
        PdfTrueType.end_table(out, slot)
        slot := slot + 16
        PdfTrueType.begin_table(out, slot, "hhea")
        PdfTrueType.copy_table(data, records, r + PTT_HHEA, out)
        PdfTrueType.end_table(out, slot)
        slot := slot + 16
        PdfTrueType.begin_table(out, slot, "hmtx")
        PdfTrueType.copy_table(data, records, r + PTT_HMTX, out)
        PdfTrueType.end_table(out, slot)
        slot := slot + 16
        ; loca: where each glyph begins in the new glyph table
        PdfTrueType.begin_table(out, slot, "loca")
        var offset 0
        g := 0
        while g < glyphs
        {
            PdfTrueType.put32(out, offset)
            if PdfTrueType.is_used(used, used_at, g)
            {
                let from PdfTrueType.location(data, records, r, g)
                let to PdfTrueType.location(data, records, r, g + 1)
                if to > from and to <= glyf_length
                    offset := offset + ((((to - from) + 3) / 4) * 4) as int
            }
            g := g + 1
        }
        PdfTrueType.put32(out, offset)
        PdfTrueType.end_table(out, slot)
        slot := slot + 16
        PdfTrueType.begin_table(out, slot, "maxp")
        PdfTrueType.copy_table(data, records, r + PTT_MAXP, out)
        PdfTrueType.end_table(out, slot)
        slot := slot + 16
        if records[r + PTT_PREP + 1] > 0
        {
            PdfTrueType.begin_table(out, slot, "prep")
            PdfTrueType.copy_table(data, records, r + PTT_PREP, out)
            PdfTrueType.end_table(out, slot)
        }
        ; the sum of the whole file comes out at a fixed number
        let sum PdfTrueType.checksum(out.as_slice(), 0, out.get_length())
        PdfTrueType.patch32(out, head_at + 8, (2981146554 - sum) & 4294967295)
    }

    ; A table begins at the end of `out`: its name and its place go into
    ; its directory entry.
    procedure begin_table(mutable out: ref[Array[u8]], slot: size_t, tag: Slice[u8])
    {
        out.put(slot, tag[0])
        out.put(slot + 1, tag[1])
        out.put(slot + 2, tag[2])
        out.put(slot + 3, tag[3])
        PdfTrueType.patch32(out, slot + 8, out.get_length() as int)
    }

    ; The table that began last ends here: its length and its checksum go
    ; into its directory entry, and the next table begins at a multiple of
    ; four.
    procedure end_table(mutable out: ref[Array[u8]], slot: size_t)
    {
        let at PdfTrueType.u32(out.as_slice(), slot + 8) as size_t
        let length out.get_length() - at
        PdfTrueType.patch32(out, slot + 12, length as int)
        while (out.get_length() & 3) <> 0
            out.add(0)
        PdfTrueType.patch32(out, slot + 4, PdfTrueType.checksum(out.as_slice(), at, length))
    }

    procedure copy_table(data: Slice[u8], records: ref[Array[int]], field: size_t, mutable out: ref[Array[u8]])
    {
        let at records[field] as size_t
        out.add(data.subslice(at, at + (records[field + 1] as size_t)))
    }

    ; The sum of the four-byte numbers a run of bytes is, the last filled
    ; up with zeros.
    function checksum(data: Slice[u8], at: size_t, length: size_t) returns int
    {
        var sum 0
        var i: size_t 0
        while i < length
        {
            var word 0
            var k: size_t 0
            while k < 4
            {
                word := word << 8
                if i + k < length
                    word := word | (data[at + i + k] as int)
                k := k + 1
            }
            sum := (sum + word) & 4294967295
            i := i + 4
        }
        sum
    }

    procedure put16(mutable out: ref[Array[u8]], value: int)
    {
        out.add(((value >> 8) & 255) as u8)
        out.add((value & 255) as u8)
    }

    procedure put32(mutable out: ref[Array[u8]], value: int)
    {
        out.add(((value >> 24) & 255) as u8)
        out.add(((value >> 16) & 255) as u8)
        out.add(((value >> 8) & 255) as u8)
        out.add((value & 255) as u8)
    }

    procedure patch32(mutable out: ref[Array[u8]], at: size_t, value: int)
    {
        out.put(at, ((value >> 24) & 255) as u8)
        out.put(at + 1, ((value >> 16) & 255) as u8)
        out.put(at + 2, ((value >> 8) & 255) as u8)
        out.put(at + 3, (value & 255) as u8)
    }
}
